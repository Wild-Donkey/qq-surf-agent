        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[^\\s]+$"
          },
          "maxItems": 30
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "text",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false
    },
    "RelationInput": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "relation": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[^\\s]+$"
