    "Group": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "number"
        },
        "manual_notes": {
          "type": "string",
          "maxLength": 20000
