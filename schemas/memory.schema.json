          "type": "array",
          "items": {
            "$ref": "#/$defs/FactInput"
          },
          "maxItems": 60
        },
        "open_threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactInput"
          },
          "maxItems": 60
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactInput"
